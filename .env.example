# Server
PORT=8080
SESSION_SECRET=replace-with-a-long-random-secret

# Cloudinary CDN Storage (required for Admin package, event & gallery uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP Mail Configuration (info@whiteswanholidays.in inquiry & auto-reply emails)
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=info@whiteswanholidays.in
MAIL_PASSWORD=your-smtp-password-or-app-password
